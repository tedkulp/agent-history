package web

import (
	"strconv"

	"github.com/tedkulp/agent-history/internal/hub/parser"
)

templ layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width,initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/chroma.css"/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body>
			<div class="wrap">
				<header class="top"><a class="brand" href="/">Agent History</a></header>
				{ children... }
			</div>
		</body>
	</html>
}

templ sourceBadge(source string) {
	<span class={ "badge", source }>{ source }</span>
}

templ feedPage(v feedView) {
	@layout("Agent History") {
		if v.Reparse != "" {
			<div class="banner reparse">⟳ { v.Reparse }</div>
		}
		for _, b := range v.Banners {
			<a class="banner" href={ templ.SafeURL(b.Href) }>⚠ { b.Text }</a>
		}
		<div class="chips">
			for _, row := range v.Chips {
				if len(row.Chips) > 0 {
					<span class="lab">{ row.Label }</span>
					for _, c := range row.Chips {
						<a class={ "chip", templ.KV("on", c.On) } href={ templ.SafeURL(c.Href) } title={ c.Title }>
							{ c.Label }
							if c.Count > 0 {
								<span class="n">{ strconv.Itoa(c.Count) }</span>
							}
						</a>
					}
				}
			}
		</div>
		if len(v.Days) == 0 {
			if v.Filtered {
				<p class="dim">No Sessions match.</p>
			} else {
				<p class="dim">No Sessions yet.</p>
			}
		}
		@feedRows(v)
	}
}

// feedRows is one page of the feed, followed by its "Load more" link. htmx
// swaps the link for the next page.
templ feedRows(v feedView) {
	for _, d := range v.Days {
		if d.Label != "" {
			<div class="day">{ d.Label }</div>
		}
		for _, r := range d.Rows {
			<a class="row" href={ templ.SafeURL(sessionHref(r.ID)) }>
				<span class="tm">{ r.Time }</span>
				<span>
					<span class="t">{ r.Title }</span>
					<span class="p">{ r.Prompt }</span>
				</span>
				<span class="r">
					if r.Failed {
						<span class="badge failed">parse failed</span>
					}
					@sourceBadge(r.Source)
					<br/>
					{ r.Machine } › <span title={ r.ProjectFull }>{ r.Project }</span>
				</span>
			</a>
		}
	}
	if v.More != "" {
		<a class="more" href={ templ.SafeURL(v.More) } hx-get={ v.More } hx-swap="outerHTML">Load more</a>
	}
}

templ transcriptPage(h headerView, outline []outlineEntry, children []childEntry, msgs []messageView) {
	@layout(h.Title + " · Agent History") {
		<div class="tr">
			<nav class="outline">
				if len(outline) > 0 {
					<div class="lab">Your prompts</div>
					for _, o := range outline {
						<a href={ templ.SafeURL("#m-" + o.ID) }>{ o.Text } <span class="n">{ o.Time }</span></a>
					}
				}
				if len(children) > 0 {
					<div class="lab">Child Sessions</div>
					for _, c := range children {
						<a href={ templ.SafeURL(c.Href) }>↳ { c.Title }</a>
					}
				}
			</nav>
			<div class="tr-main">
				<div class="head">
					<h1>{ h.Title }</h1>
					<div class="m">
						@sourceBadge(h.Source)
						<a href={ templ.SafeURL(h.MachineHref) }>{ h.Machine }</a>
						<a href={ templ.SafeURL(h.ProjectHref) } title={ h.ProjectFull }>{ h.Project }</a>
						if h.GitBranch != "" {
							<span>⎇ { h.GitBranch }</span>
						}
						if h.Model != "" {
							<span>{ h.Model }</span>
						}
						if h.Started != "" {
							<span>{ h.Started }</span>
						}
						if h.ParentHref != "" {
							<a class="parent" href={ templ.SafeURL(h.ParentHref) }>{ h.ParentLabel }</a>
						} else if h.ParentLabel != "" {
							<span class="parent">{ h.ParentLabel }</span>
						}
					</div>
					if h.ParseError != "" {
						@failureNote(h)
					}
					if h.WarningNote != "" {
						@notes(h)
					}
				</div>
				for _, m := range msgs {
					<div class={ "msg", m.Role, templ.KV("marker", m.Marker) } id={ "m-" + m.ID }>
						for _, c := range m.Chunks {
							@chunk(c)
						}
						<span class="time">{ m.Time }</span>
					</div>
				}
			</div>
		</div>
	}
}

// failureNote shows why the latest parse failed, above the last good
// Transcript, or alone when there never was one (hub.md §4.7).
templ failureNote(h headerView) {
	<details class="notes failed">
		<summary>✗ parse failed</summary>
		<pre>{ h.ParseError }</pre>
		if h.Parsed {
			<p class="dim">Showing the last Transcript that parsed.</p>
		} else {
			<p class="dim">This Session has never parsed, so there is no Transcript to show.</p>
		}
	</details>
}

// notes lists the Session's Parse warnings, collapsed (hub.md §4.7).
templ notes(h headerView) {
	<details class="notes">
		<summary>⚠ { h.WarningNote }</summary>
		<ul>
			for _, w := range h.Warnings {
				<li>
					<b>{ w.Kind }</b>
					if w.SourceType != "" {
						<code>{ w.SourceType }</code>
					}
					×{ strconv.Itoa(w.Count) }
					if h.SourceVersion != "" {
						<span class="dim">· { h.Source } { h.SourceVersion }</span>
					}
					if w.FirstExcerpt != "" {
						<pre>{ w.FirstExcerpt }</pre>
					}
				</li>
			}
		</ul>
	</details>
}

// chunk renders one piece of a Message.
templ chunk(c chunkView) {
	if c.Tools != nil {
		@toolCluster(c)
	} else if c.Image != nil {
		<a class="img" href={ templ.SafeURL(c.Image.Src) } target="_blank">
			<img src={ c.Image.Src } alt={ c.Image.Alt } loading="lazy"/>
		</a>
	} else if c.Marker != nil {
		if c.Marker.Body != "" {
			<details class={ "marker", c.Marker.Kind }>
				<summary>{ c.Marker.Label }</summary>
				<div class="bubble">
					@templ.Raw(c.Marker.Body)
				</div>
			</details>
		} else {
			<div class={ "marker", c.Marker.Kind }>{ c.Marker.Label }</div>
		}
	} else if c.Unknown != nil {
		<div class="bubble unknown">
			⚠ unknown <code>{ c.Unknown.SourceType }</code>
			<pre>{ c.Unknown.Excerpt }</pre>
		</div>
	} else if c.Thinking != "" {
		<details class="think">
			<summary>💭 thinking</summary>
			@templ.Raw(c.Thinking)
		</details>
	} else if c.Attachment != "" {
		<div class="att">📎 { c.Attachment }</div>
	} else {
		<div class="bubble">
			@templ.Raw(c.HTML)
		</div>
	}
}

// toolCluster is a run of consecutive tool calls, folded into one collapsed
// row (hub.md §4.7).
templ toolCluster(c chunkView) {
	<details class="cluster" open?={ c.Open }>
		<summary>{ c.Label }</summary>
		for _, t := range c.Tools {
			<details class="tool" id={ "p-" + t.ID }>
				<summary>
					<b>{ t.Name }</b>
					if t.ChildHref != "" {
						<a class="child" href={ templ.SafeURL(t.ChildHref) }>↳ Child Session</a>
					}
					if t.Summary != "" {
						<span class="dim">{ t.Summary }</span>
					}
					<span class={ "st", t.Status }>
						switch t.Status {
							case parser.StatusOK:
								✓
							case parser.StatusError:
								✗
							default:
								⋯
						}
					</span>
				</summary>
				<div class="body">
					if t.Diff != nil {
						<div class="diff">
							<div class="diff-file">{ t.Diff.Path }</div>
							<pre>
								for _, l := range t.Diff.Lines {
									<span class={ l.Class }>{ l.Text }</span>
								}
							</pre>
						</div>
					} else {
						<pre class="in">{ t.Input }</pre>
					}
					if t.Stub != "" {
						<div class="stub" hx-get={ t.OutputURL } hx-trigger="click" hx-swap="outerHTML">
							<div>▸ { t.Stub }</div>
							if t.Preview != "" {
								<pre class="preview">{ t.Preview }</pre>
							}
						</div>
					} else if t.HasOutput {
						@toolOutputFragment(t.Output)
					}
				</div>
			</details>
		}
	</details>
}

// toolOutputFragment is a tool call's output as preformatted text, never
// Markdown or HTML (hub.md §4.6).
templ toolOutputFragment(out string) {
	<pre class="out">{ out }</pre>
}

templ notFoundPage() {
	@layout("Not found · Agent History") {
		<p>No such Session.</p>
	}
}
