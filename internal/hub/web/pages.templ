package web

import "strconv"

templ layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width,initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/chroma.css"/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body>
			<div class="wrap">
				<header class="top"><a class="brand" href="/">Agent History</a></header>
				{ children... }
			</div>
		</body>
	</html>
}

templ sourceBadge(source string) {
	<span class={ "badge", source }>{ source }</span>
}

templ feedPage(v feedView) {
	@layout("Agent History") {
		<div class="chips">
			for _, row := range v.Chips {
				if len(row.Chips) > 0 {
					<span class="lab">{ row.Label }</span>
					for _, c := range row.Chips {
						<a class={ "chip", templ.KV("on", c.On) } href={ templ.SafeURL(c.Href) } title={ c.Title }>
							{ c.Label }
							if c.Count > 0 {
								<span class="n">{ strconv.Itoa(c.Count) }</span>
							}
						</a>
					}
				}
			}
		</div>
		if len(v.Days) == 0 {
			if v.Filtered {
				<p class="dim">No Sessions match.</p>
			} else {
				<p class="dim">No Sessions yet.</p>
			}
		}
		@feedRows(v)
	}
}

// feedRows is one page of the feed, followed by its "Load more" link. htmx
// swaps the link for the next page.
templ feedRows(v feedView) {
	for _, d := range v.Days {
		if d.Label != "" {
			<div class="day">{ d.Label }</div>
		}
		for _, r := range d.Rows {
			<a class="row" href={ templ.SafeURL("/sessions/" + strconv.FormatInt(r.ID, 10)) }>
				<span class="tm">{ r.Time }</span>
				<span>
					<span class="t">{ r.Title }</span>
					<span class="p">{ r.Prompt }</span>
				</span>
				<span class="r">
					@sourceBadge(r.Source)
					<br/>
					{ r.Machine } › <span title={ r.ProjectFull }>{ r.Project }</span>
				</span>
			</a>
		}
	}
	if v.More != "" {
		<a class="more" href={ templ.SafeURL(v.More) } hx-get={ v.More } hx-swap="outerHTML">Load more</a>
	}
}

templ transcriptPage(h headerView, msgs []messageView) {
	@layout(h.Title + " · Agent History") {
		<div class="head">
			<h1>{ h.Title }</h1>
			<div class="m">
				@sourceBadge(h.Source)
				<a href={ templ.SafeURL(h.MachineHref) }>{ h.Machine }</a>
				<a href={ templ.SafeURL(h.ProjectHref) } title={ h.ProjectFull }>{ h.Project }</a>
				if h.GitBranch != "" {
					<span>⎇ { h.GitBranch }</span>
				}
				if h.Model != "" {
					<span>{ h.Model }</span>
				}
				if h.Started != "" {
					<span>{ h.Started }</span>
				}
			</div>
		</div>
		for _, m := range msgs {
			<div class={ "msg", m.Role } id={ "m-" + m.ID }>
				for _, p := range m.Texts {
					<div class="bubble">
						@templ.Raw(p)
					</div>
				}
				<span class="time">{ m.Time }</span>
			</div>
		}
	}
}

templ notFoundPage() {
	@layout("Not found · Agent History") {
		<p>No such Session.</p>
	}
}
