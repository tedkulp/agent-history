package web

import (
	"strconv"

	"github.com/tedkulp/agent-history/internal/hub/parser"
)

templ layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width,initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/chroma.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body>
			<div class="wrap">
				<header class="top"><a class="brand" href="/">Agent History</a></header>
				{ children... }
			</div>
		</body>
	</html>
}

templ sourceBadge(source string) {
	<span class={ "badge", source }>{ source }</span>
}

// searchForm is the search box. Hidden fields carry the active chips, which
// apply to the search too (hub.md §4.7).
templ searchForm(p feedParams) {
	<form class="search" action="/">
		<input type="search" name="q" value={ p.Q } placeholder="Search every Transcript on every Machine…" aria-label="Search" autofocus/>
		if p.Q != "" {
			<a class="clear" href={ templ.SafeURL(p.withQ("").url()) } title="Clear search" aria-label="Clear search">✕</a>
		}
		if p.Machine != "" {
			<input type="hidden" name="machine" value={ p.Machine }/>
		}
		if p.Project != "" {
			<input type="hidden" name="project" value={ p.Project }/>
		}
		if p.Source != "" {
			<input type="hidden" name="source" value={ p.Source }/>
		}
		if p.Warnings {
			<input type="hidden" name="warnings" value="1"/>
		}
	</form>
}

templ chipRows(rows []chipRow) {
	<div class="chips">
		for _, row := range rows {
			if len(row.Chips) > 0 {
				<span class="lab">{ row.Label }</span>
				for _, c := range row.Chips {
					<a class={ "chip", templ.KV("on", c.On) } href={ templ.SafeURL(c.Href) } title={ c.Title }>
						{ c.Label }
						if c.Count > 0 {
							<span class="n">{ strconv.Itoa(c.Count) }</span>
						}
					</a>
				}
			}
		}
	</div>
}

templ feedPage(v feedView) {
	@layout("Agent History") {
		@searchForm(v.Params)
		if v.Reparse != "" {
			@reparseBanner(v.Reparse)
		}
		for _, b := range v.Banners {
			<a class="banner" href={ templ.SafeURL(b.Href) }>⚠ { b.Text }</a>
		}
		@chipRows(v.Chips)
		// On the first page, app.js places rows here as Sessions are parsed
		// from live data (hub.md §4.7).
		<div class="feed" { v.liveAttrs()... }>
			if len(v.Days) == 0 {
				if v.Filtered {
					<p class="dim empty">No Sessions match.</p>
				} else {
					<p class="dim empty">No Sessions yet.</p>
				}
			}
			@feedRows(v)
		</div>
	}
}

// reparseBanner polls /reparse every 3 s while text is set. Once the
// re-parse is done it offers a reload of this page instead, so re-parsed rows
// show on the next load (hub.md §4.7).
templ reparseBanner(text string) {
	if text != "" {
		<div class="banner reparse" hx-get="/reparse" hx-trigger="every 3s" hx-swap="outerHTML">⟳ { text }</div>
	} else {
		// An empty href reloads the current URL.
		<a class="banner reparse" href="">✓ Re-parse finished · reload</a>
	}
}

// feedRows is one page of the feed, followed by its "Load more" link. htmx
// swaps the link for the next page. Each row carries its Session, time and
// day label, so the live feed can place it (app.js).
templ feedRows(v feedView) {
	for _, d := range v.Days {
		if d.Label != "" {
			<div class="day">{ d.Label }</div>
		}
		for _, r := range d.Rows {
			<a class="row" href={ templ.SafeURL(sessionHref(r.ID)) } data-id={ strconv.FormatInt(r.ID, 10) } data-at={ strconv.FormatInt(r.LastActivityAt, 10) } data-day={ r.Day }>
				<span class="tm">{ r.Time }</span>
				<span>
					<span class="t">{ r.Title }</span>
					<span class="p">{ r.Prompt }</span>
				</span>
				<span class="r">
					if r.Failed {
						<span class="badge failed">parse failed</span>
					}
					@sourceBadge(r.Source)
					<br/>
					{ r.Machine } › <span title={ r.ProjectFull }>{ r.Project }</span>
				</span>
			</a>
		}
	}
	if v.More != "" {
		<a class="more" href={ templ.SafeURL(v.More) } hx-get={ v.More } hx-swap="outerHTML">Load more</a>
	}
}

// searchPage is the search results: ranked hits beside a facet sidebar
// (hub.md §4.7).
templ searchPage(v searchView) {
	@layout(v.Params.Q + " · Agent History") {
		@searchForm(v.Params)
		@chipRows(v.Chips)
		<div class="results">
			<div class="hits">
				if len(v.Hits) == 0 {
					<p class="dim">No matches.</p>
				}
				@searchHits(v)
			</div>
			<aside class="facets">
				for _, g := range v.Facets {
					if len(g.Items) > 0 {
						<h4>{ g.Label }</h4>
						for _, f := range g.Items {
							<a class={ templ.KV("on", f.On) } href={ templ.SafeURL(f.Href) } title={ f.Title }>
								<span>{ f.Label }</span>
								<span class="n">{ strconv.Itoa(f.Hits) }</span>
							</a>
						}
					}
				}
			</aside>
		</div>
	}
}

// searchHits is one page of hits, followed by its "Load more" link. htmx
// swaps the link for the next page.
templ searchHits(v searchView) {
	for _, h := range v.Hits {
		<a class="hit" href={ templ.SafeURL(h.Href) }>
			<div class="t">
				@h.Title
			</div>
			if h.ChildOf != "" {
				<div class="child">{ h.ChildOf }</div>
			}
			if h.Snippet != nil {
				<div class="snip">
					@h.Snippet
				</div>
			}
			<div class="m">
				@sourceBadge(h.Source)
				· { h.Machine } › <span title={ h.ProjectFull }>{ h.Project }</span> · { h.Role }
			</div>
		</a>
	}
	if v.More != "" {
		<a class="more" href={ templ.SafeURL(v.More) } hx-get={ v.More } hx-swap="outerHTML">Load more</a>
	}
}

// transcriptPage is a Session's Transcript. The data attributes let app.js
// catch up in place when the Session is re-parsed (hub.md §4.7).
templ transcriptPage(st liveState, v transcriptView) {
	@layout(v.Head.Title + " · Agent History") {
		<div class="tr">
			<nav class="outline">
				<div class="outline-prompts">
					<div class="lab">Your prompts</div>
					<div class="prompts">
						@outlinePrompts(v.Outline)
					</div>
				</div>
				@childSessions(v.Children)
			</nav>
			<div class="tr-main" data-events={ st.Events } data-messages={ st.Messages } data-after={ st.After } data-count={ strconv.Itoa(st.Count) }>
				@transcriptHead(v.Head)
				<div class="tr-msgs">
					for _, m := range v.Messages {
						@message(m)
					}
				</div>
			</div>
		</div>
		// app.js shows this once the reader scrolls past the header.
		<a class="to-top" href="#top" hidden><span aria-hidden="true">↑</span> Top</a>
	}
}

// transcriptUpdate is what an open Transcript page swaps in after a re-parse:
// the header and Child Sessions afresh, the outline entries and Messages to
// replace or append by id, and the page's new last Message and count.
templ transcriptUpdate(st liveState, v transcriptView) {
	<div class="tr-update" data-after={ st.After } data-count={ strconv.Itoa(st.Count) }>
		@transcriptHead(v.Head)
		<div class="prompts">
			@outlinePrompts(v.Outline)
		</div>
		@childSessions(v.Children)
		<div class="tr-msgs">
			for _, m := range v.Messages {
				@message(m)
			}
		</div>
	</div>
}

templ outlinePrompts(outline []outlineEntry) {
	for _, o := range outline {
		<a href={ templ.SafeURL("#m-" + o.ID) } data-m={ o.ID }>{ o.Text } <span class="n">{ o.Time }</span></a>
	}
}

templ childSessions(children []childEntry) {
	<div class="outline-children">
		if len(children) > 0 {
			<div class="lab">Child Sessions</div>
			for _, c := range children {
				<a href={ templ.SafeURL(c.Href) }>↳ { c.Title }</a>
			}
		}
	</div>
}

templ transcriptHead(h headerView) {
	<div class="head">
		<h1 id="top" tabindex="-1">{ h.Title }</h1>
		<div class="m">
			@sourceBadge(h.Source)
			<a href={ templ.SafeURL(h.MachineHref) }>{ h.Machine }</a>
			<a href={ templ.SafeURL(h.ProjectHref) } title={ h.ProjectFull }>{ h.Project }</a>
			if h.GitBranch != "" {
				<span>⎇ { h.GitBranch }</span>
			}
			if h.Model != "" {
				<span>{ h.Model }</span>
			}
			if h.Started != "" {
				<span>{ h.Started }</span>
			}
			if h.ParentHref != "" {
				<a class="parent" href={ templ.SafeURL(h.ParentHref) }>{ h.ParentLabel }</a>
			} else if h.ParentLabel != "" {
				<span class="parent">{ h.ParentLabel }</span>
			}
			if h.ForkHref != "" {
				<a class="fork" href={ templ.SafeURL(h.ForkHref) }>{ h.ForkLabel }</a>
			} else if h.ForkLabel != "" {
				<span class="fork">{ h.ForkLabel }</span>
			}
		</div>
		if h.ParseError != "" {
			@failureNote(h)
		}
		if h.WarningNote != "" {
			@notes(h)
		}
	</div>
}

templ message(m messageView) {
	<div class={ "msg", m.Role, templ.KV("marker-row", m.Marker) } id={ "m-" + m.ID }>
		for _, c := range m.Chunks {
			@chunk(c)
		}
		<span class="time">{ m.Time }</span>
	</div>
}

// failureNote shows why the latest parse failed, above the last good
// Transcript, or alone when there never was one (hub.md §4.7).
templ failureNote(h headerView) {
	<details class="notes failed">
		<summary>✗ parse failed</summary>
		<pre>{ h.ParseError }</pre>
		if h.Parsed {
			<p class="dim">Showing the last Transcript that parsed.</p>
		} else {
			<p class="dim">This Session has never parsed, so there is no Transcript to show.</p>
		}
	</details>
}

// notes lists the Session's Parse warnings, collapsed (hub.md §4.7).
templ notes(h headerView) {
	<details class="notes">
		<summary>⚠ { h.WarningNote }</summary>
		<ul>
			for _, w := range h.Warnings {
				<li>
					<b>{ w.Kind }</b>
					if w.SourceType != "" {
						<code>{ w.SourceType }</code>
					}
					×{ strconv.Itoa(w.Count) }
					if h.SourceVersion != "" {
						<span class="dim">· { h.Source } { h.SourceVersion }</span>
					}
					if w.FirstExcerpt != "" {
						<pre>{ w.FirstExcerpt }</pre>
					}
				</li>
			}
		</ul>
	</details>
}

// chunk renders one piece of a Message.
templ chunk(c chunkView) {
	if c.Tools != nil {
		@toolCluster(c)
	} else if c.Image != nil {
		<a class="img" href={ templ.SafeURL(c.Image.Src) } target="_blank">
			<img src={ c.Image.Src } alt={ c.Image.Alt } loading="lazy"/>
		</a>
	} else if c.Marker != nil && c.Marker.Task != nil {
		@taskMarker(c.Marker)
	} else if c.Marker != nil {
		if c.Marker.Output != "" {
			<details class={ "marker", c.Marker.Kind }>
				<summary>{ c.Marker.Label }</summary>
				<pre class="out">{ c.Marker.Output }</pre>
				if c.Marker.More != "" {
					<p class="dim">{ c.Marker.More }</p>
				}
			</details>
		} else if c.Marker.Body != "" {
			<details class={ "marker", c.Marker.Kind }>
				<summary>{ c.Marker.Label }</summary>
				<div class="bubble">
					@templ.Raw(c.Marker.Body)
				</div>
			</details>
		} else {
			<div class={ "marker", c.Marker.Kind }>{ c.Marker.Label }</div>
		}
	} else if c.Unknown != nil {
		<div class="bubble unknown">
			⚠ unknown <code>{ c.Unknown.SourceType }</code>
			<pre>{ c.Unknown.Excerpt }</pre>
		</div>
	} else if c.Thinking != "" {
		<details class="think">
			<summary>💭 thinking</summary>
			@templ.Raw(c.Thinking)
		</details>
	} else if c.Attachment != "" {
		<div class="att">📎 { c.Attachment }</div>
	} else {
		<div class="bubble">
			@templ.Raw(c.HTML)
		</div>
	}
}

// taskMarker is a task_notification pill: status, summary, usage and a link
// to the call that started the task. Its result or event opens below it
// (hub.md §4.7).
templ taskMarker(m *markerView) {
	if m.Body != "" || m.Output != "" {
		<details class={ "marker", m.Kind, templ.KV(m.Task.Status, m.Task.Status != "") } id={ "p-" + m.Task.ID }>
			<summary>
				@taskLine(m)
			</summary>
			if m.Body != "" {
				<div class="bubble">
					@templ.Raw(m.Body)
				</div>
			}
			if m.Output != "" {
				<pre class="out">{ m.Output }</pre>
				if m.More != "" {
					<p class="dim">{ m.More }</p>
				}
			}
		</details>
	} else {
		<div class={ "marker", m.Kind, templ.KV(m.Task.Status, m.Task.Status != "") } id={ "p-" + m.Task.ID }>
			@taskLine(m)
		</div>
	}
}

templ taskLine(m *markerView) {
	<span class={ "st", templ.KV(m.Task.Status, m.Task.Status != "") }>
		switch m.Task.Status {
			case parser.TaskCompleted:
				✓
			case parser.TaskFailed:
				✗
			case parser.TaskKilled:
				■
			default:
				•
		}
	</span> { m.Label }
	if m.Task.Usage != "" {
		<span class="dim">· { m.Task.Usage }</span>
	}
	if m.Task.CallHref != "" {
		<a class="call" href={ templ.SafeURL(m.Task.CallHref) }>↑ call</a>
	}
}

// toolStatus is a tool call's ✓, ✗ or ⋯. toolCluster calls it in both arms
// of an if: followed by an if instead, templ would add a trailing space to
// every row without a target.
templ toolStatus(status string) {
	<span class={ "st", status }>
		switch status {
			case parser.StatusOK:
				✓
			case parser.StatusError:
				✗
			default:
				⋯
		}
	</span>
}

// toolCluster is a run of consecutive tool calls, folded into one collapsed
// row (hub.md §4.7).
templ toolCluster(c chunkView) {
	<details class="cluster" open?={ c.Open }>
		<summary>{ c.Label }</summary>
		for _, t := range c.Tools {
			<details class="tool" id={ "p-" + t.ID }>
				<summary>
					<b>{ t.Name }</b>
					for _, h := range t.ChildHrefs {
						<a class="child" href={ templ.SafeURL(h) }>↳ Child Session</a>
					}
					for _, h := range t.NoteHrefs {
						<a class="call" href={ templ.SafeURL(h) }>↓ notified</a>
					}
					if t.Summary != "" {
						<span class="dim">{ t.Summary }</span>
					}
					if t.Target != "" {
						@toolStatus(t.Status)
						<code class="target">{ t.Target }</code>
					} else {
						@toolStatus(t.Status)
					}
				</summary>
				<div class="body">
					if t.Diff != nil {
						<div class="diff">
							<div class="diff-file">{ t.Diff.Path }</div>
							<pre>
								for _, l := range t.Diff.Lines {
									<span class={ l.Class }>{ l.Text }</span>
								}
							</pre>
						</div>
					} else {
						<pre class="in">{ t.Input }</pre>
					}
					if t.Stub != "" {
						<div class="stub" hx-get={ t.OutputURL } hx-trigger="click" hx-swap="outerHTML">
							<div>▸ { t.Stub }</div>
							if t.Preview != "" {
								<pre class="preview">{ t.Preview }</pre>
							}
						</div>
					} else if t.HasOutput {
						@toolOutputFragment(t.Output)
					}
				</div>
			</details>
		}
	</details>
}

// toolOutputFragment is a tool call's output as preformatted text, never
// Markdown or HTML (hub.md §4.6).
templ toolOutputFragment(out string) {
	<pre class="out">{ out }</pre>
}

templ notFoundPage() {
	@layout("Not found · Agent History") {
		<p>No such Session.</p>
	}
}
