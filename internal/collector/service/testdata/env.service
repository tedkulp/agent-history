[Unit]
Description=Agent History Collector
X-AgentHistoryTemplate=1

[Service]
ExecStart="/home/ted/my tools/100%%/$$bin/agent-history" run
Environment=HOME=/home/ted
Environment="MISE_DATA_DIR=/home/ted/\"mise\""
Environment="XDG_CONFIG_HOME=/home/ted/my config"
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
